let s:VimPluginsPath = $HOME . '/vimplugins'
let s:VimPlugins = []

function! s:plug(plugin) abort
	call add(s:VimPlugins, a:plugin)
endfunction

function! s:IsEnable(plugin) abort
	return index(s:VimPlugins, a:plugin) != -1 ? 1 : 0
endfunction

"***************************************
" vim original plugin
"***************************************
packadd cfilter
packadd matchit
if v:version >= 902
	packadd comment
endif

"***************************************
" Define load plugin
"***************************************
call s:plug('iceberg.vim')
call s:plug('stline.vim')
call s:plug('gr.vim')
call s:plug('nexusfile.vim')
call s:plug('vimdoc-ja')
call s:plug('winbuf.vim')
call s:plug('unmemorable.vim')
call s:plug('glog.vim')
call s:plug('popupmarks.vim')
call s:plug('niftybox.vim')

"***************************************
" Define plugin loading configuration
"***************************************
function! s:load_config() abort
	" jonathanfilip/vim-lucius
	if s:IsEnable('vim-lucius')
		colorscheme lucius
		let g:lucius_style = 'dark'
	endif

	" cocoon/iceberg.vim
	if s:IsEnable('iceberg.vim')
		set termguicolors
		set background=dark
		colorscheme iceberg
	endif

	" atsumori123/stline.vim
	if s:IsEnable('stline.vim')
		let g:stline_theme = 'iceberg'
		nnoremap <leader>1			<Plug>STLine.Go(1)
		nnoremap <leader>2			<Plug>STLine.Go(2)
		nnoremap <leader>3			<Plug>STLine.Go(3)
		nnoremap <leader>4			<Plug>STLine.Go(4)
		nnoremap <leader>5			<Plug>STLine.Go(5)
		nnoremap <leader>6			<Plug>STLine.Go(6)
		nnoremap <leader>7			<Plug>STLine.Go(7)
		nnoremap <leader>8			<Plug>STLine.Go(8)
		nnoremap <leader>9			<Plug>STLine.Go(9)
		nnoremap <leader>0			<Plug>STLine.Go(10)
	endif

	" atsumori123/gr.vim
	if s:IsEnable('gr.vim')
		let g:gr_grepprg = 'vim grep'	" vim grep/grep/git grep/rip grep
		noremap <silent><leader>g   :Gr<CR>
	endif

	" atsumori123/nexusfile.vim
	if s:IsEnable('nexusfile.vim')
		nnoremap <silent>\          :execute "NXExplorer " . expand("%:p:h")<CR>
		nnoremap <silent><c-e>      :execute 'NXFinder c:\Users\atsu3\vimplugins'<CR>
		nnoremap <silent><leader>l  :NXMru<CR>
	endif

	" atsumori123/winbuf.vim
	if s:IsEnable('winbuf.vim')
		let g:winbuf_switch_all_window = 1
		let g:winbuf_shell_type = &shell	" bash
		nnoremap <silent><leader>b  :<C-u>call buffer#list()<CR>
		nnoremap <silent>q          :<C-u>call buffer#close(0)<CR>
		nnoremap <silent><C-q>      :<C-u>call buffer#close(1)<CR>
		nnoremap <silent><C-l>      :<C-u>call switch_buffer#switch_buffer(1)<CR>
		nnoremap <silent><C-h>      :<C-u>call switch_buffer#switch_buffer(-1)<CR>
		nnoremap <silent><TAB>      :<C-u>call switch_window#switch_window(1)<CR>
		nnoremap <silent><S-TAB>    :<C-u>call switch_window#switch_window(-1)<CR>
		nnoremap <silent>@          :<C-u>call switch_window#switch_special_window()<CR>
		nnoremap <silent><C-w>s     :<C-u>call resize_window#resize_window()<CR>
		nnoremap <silent><C-t>      :<C-u>call terminal#toggle_terminal()<CR>
		tnoremap <silent><C-t>      :<C-u><C-\><C-n>:call terminal#toggle_terminal()<CR>
		nnoremap <silent><C-p>      :<C-u>call quickfix#toggle_preview()<CR>
		nnoremap <silent><leader>q  :<C-u>call quickfix#toggle_quickfix()<CR>
	endif

	" atsumori123/niftybox.vim
	if s:IsEnable('niftybox.vim')
		let g:niftybox_easymotion_enable = 1
		let g:niftybox_taglist_enable    = 1
		nnoremap <silent>f          :<C-u>call easymotion#start()<CR>
		nnoremap <silent><F3>       :<C-u>call taglist#open()<CR>
		noremap  <silent><leader>r  :Replace<CR>
	endif

	" atsumori123/unmemorable.vim
	if s:IsEnable('unmemorable.vim')
		let g:unmemorable_auto_complete_enable = 1
		let g:unmemorable_osc52yank = 0		" 0:OFF, 1:ON, 2:ON(cp932)
		noremap <leader>t			:Unmemorable<CR>
	endif

	" atsumori123/popupmarks.vim
	if s:IsEnable('popupmarks.vim')
		nnoremap <silent><leader>m	:OpenMarks<CR>
		nnoremap <silent>ma			:EditMarks Add<CR>
		nnoremap <silent>md			:EditMarks Del<CR>
		nnoremap <silent>me			:EditMarks Edit<CR>
	endif

	" atsumori123/glog.vim
	if s:IsEnable('glog.vim')
		let g:gsign_disable = 0
	endif

	" for test
	nnoremap <leader>[ :<C-u>source ~/vimfiles/script/test.vim<CR>
endfunction

